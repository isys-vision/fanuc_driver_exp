! --------------------
!
! ROS-Industrial Fanuc Driver 'Exp' uninstall script.
!
! author: G.A. vd. Hoorn (TU Delft Robotics Institute)
!
! NOTE: this does NOT undo the changes to $HOSTS_CFG.
!
! version: ROS//r3b
!
! --------------------
!
DELPC   LIBINDLOG
VRCLEAR LIBINDLOG
DELPC   LIBMATHEX
VRCLEAR LIBMATHEX
DELPC   LIBROSFANUC
VRCLEAR LIBROSFANUC
DELPC   LIBSM000A
VRCLEAR LIBSM000A
DELPC   LIBSM000B
VRCLEAR LIBSM000B
DELPC   LIBSM000D
VRCLEAR LIBSM000D
DELPC   LIBSMFDF0
VRCLEAR LIBSMFDF0
DELPC   LIBSMFDF1
VRCLEAR LIBSMFDF1
DELPC   LIBSMFDF2
VRCLEAR LIBSMFDF2
DELPC   LIBSM_HDR
VRCLEAR LIBSM_HDR
DELPC   LIBSSOCK
VRCLEAR LIBSSOCK
DELPC   ROS_TRAJ
VRCLEAR ROS_TRAJ
DELPC   ROS_STATE
VRCLEAR ROS_STATE
DELPC   LIBIND_LOG
VRCLEAR LIBIND_LOG
DELPC   LIBIO_PKT
VRCLEAR LIBIO_PKT
DELPC   ROS_IO
VRCLEAR ROS_IO
DELTP   ROS_MOVESM
DELTP   MIKADO
