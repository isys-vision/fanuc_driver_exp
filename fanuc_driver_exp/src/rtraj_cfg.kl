PROGRAM rtraj_cfg
--------------------------------------------------------------------------------
--
-- ROS-Industrial configuration setup program - ROS_TRAJ.
--
-- NOTE: this program will configure ROS_TRAJ with its DEFAULT SETTINGS.
--
--
-- author: G.A. vd. Hoorn (TU Delft Robotics Institute)
--
--------------------------------------------------------------------------------
%ALPHABETIZE
%COMMENT = 'ROS//r3b'
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR




--------------------------------------------------------------------------------
--
-- remote types & constants
--
--------------------------------------------------------------------------------
%INCLUDE simplemsg\simplemsg.klt




--------------------------------------------------------------------------------
--
-- local types & constants
--
--------------------------------------------------------------------------------
CONST
	PROG_NAME    = 'ROS_TRAJ'

	FILE_ILL_PRM =  2032 -- FILE-032 Illegal parameter
	SEV_ABORT    =    2  -- ABORT severity

	-- config defaults
	RACCEPT_DLAY = 1000  -- default 'return to sock_accept' delay

	TAG_NR       =    4  -- Server tag
	TCP_PORT     =    SM_SP_MOTION

	LOOP_HZ      =   125  -- Main loop freq (Hz).On 12ms ITP controllers
	                     -- ROS_TRAJ will run at 83 Hz (GH #203).

	MOT_SKIP_SIG =    1  -- value to write to SKIP CONDITION register to signal
	                     -- motion abort to TP side

	NW_PT_BUF_SZ  =    6  -- desired nr of TRAJ_PTs in buffer


	-- ros_movesm interface defaults:
	R_SKPSIG_IDX =    35  -- integer register: SKIP CONDITION register

	PT_BUFF_SIZE = 10 -- TWO BUFFERS! DOUBLE THE AMOUNT OF PRs REQUIRED
	FIRST_PR_B1  = 10
	FIRST_PR_B2  = 20
	R_PTS_NW_BUF = 30
	R_FRST_PR_B1 = 31
	R_FRST_PR_B2 = 32
	R_BUFF1_PTS  = 33
	R_BUFF2_PTS  = 34
	R_BUFF_R2R   = 39 -- number of register indicating which buffer is ready to read
	R_BUFF_CON   = 40 -- nr of reg indicating which buffer has been consumed by mvm code
	R_BUFF_ACT   = 41 -- nr of reg indicating active buffer





--------------------------------------------------------------------------------
--
-- local variables
--
--------------------------------------------------------------------------------
VAR
	stat_        : INTEGER




--------------------------------------------------------------------------------
--
-- remote routine prototypes
--
--------------------------------------------------------------------------------




--------------------------------------------------------------------------------
--
-- local routine prototypes
--
--------------------------------------------------------------------------------




--------------------------------------------------------------------------------
--
-- Main program
--
--------------------------------------------------------------------------------
BEGIN
	stat_ = 0

	-- set all settings to their defaults

	SET_VAR(0, PROG_NAME, 'cfg_.loop_hz', LOOP_HZ, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.r_skip_sig', R_SKPSIG_IDX, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.s_accpt_dlay', RACCEPT_DLAY, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.s_tag_nr', TAG_NR, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.s_tcp_nr', TCP_PORT, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.tp_val_trstp', MOT_SKIP_SIG, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.nw_pt_buf_sz', NW_PT_BUF_SZ, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.um_clear', TRUE, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.pt_buff_size', PT_BUFF_SIZE, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.first_pr_b1', FIRST_PR_B1, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.first_pr_b2', FIRST_PR_B2, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF
	
	SET_VAR(0, PROG_NAME, 'cfg_.r_frst_pr_b1', R_FRST_PR_B1, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.r_frst_pr_b2', R_FRST_PR_B2, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.r_buff1_pts', R_BUFF1_PTS, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.r_buff2_pts', R_BUFF2_PTS, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.r_pts_nw_buf', R_PTS_NW_BUF, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.r_buff_r2r', R_BUFF_R2R, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.r_buff_con', R_BUFF_CON, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.r_buff_act', R_BUFF_ACT, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

END rtraj_cfg
