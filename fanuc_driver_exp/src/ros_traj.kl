PROGRAM ros_traj
--------------------------------------------------------------------------------
--
-- ROS-Industrial joint trajectory relay.
--
-- Currently only supports joint trajectory point streaming.
--
--
-- Assumptions:
--   - User Socket Messaging (USM) is supported by robot
--   - There is only 1 motion group
--   - The TP program 'ros_movesm' exists on the robot
--
--
-- Configuration defaults:
--   - TAG 'S4' used for USM
--   - Relay TCP port ROS-I default (11000)
--   - Position registers 61 to 90 available
--   - Integer registers 71 to 76 are available
--   - DOs 145 and 146 are available
--   - Motion termination is at CNT 100% apart from last point (FINE)
--
--
-- author: G.A. vd. Hoorn (TU Delft Robotics Institute)
--
--------------------------------------------------------------------------------
%ALPHABETIZE
%COMMENT = 'ROS//r3b'
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR



--------------------------------------------------------------------------------
--
-- remote types & constants
--
--------------------------------------------------------------------------------
%INCLUDE rosfanuc\rosfanuc.klt
%INCLUDE simplemsg\msgs\sm000A.klt
%INCLUDE mikmsgs\smFDF0.klt
%INCLUDE mikmsgs\smFDF2.klt
%INCLUDE simplemsg\simplemsg.klt
%INCLUDE libssock.klt



--------------------------------------------------------------------------------
--
-- local types & constants
--
--------------------------------------------------------------------------------
TYPE
	-- NOTE: all items that configure the 'interface' with ROS_MOVESM will need
	--       to be in-sync with whatever the ROS_MOVESM TP prog is using (flags,
	--       int registers, pos registers, values, etc).
	cfg_t = STRUCTURE
		pt_buff_size : INTEGER  -- size of buffer
		r_buff_size  : INTEGER  -- buff size
		first_pr     : INTEGER  -- first pr of buffer
		r_first_pr   : INTEGER  -- int reg to store first pr
		r_pts_to_drv : INTEGER  -- r of nr of pts that still need to be driven
		loop_hz      : INTEGER  -- main loop update rate (in Hz)
		r_skip_sig   : INTEGER  -- int reg monitored by SKIP CONDITION in TP
		s_accpt_dlay : INTEGER  -- 'return to sock_accept' delay (ms)
		s_tag_nr     : INTEGER  -- server TAG number to use
		s_tcp_nr     : INTEGER  -- TCP port to listen on
		tp_val_trstp : INTEGER  -- value to set 'r_skip_sig' reg to to communicate traj stop
		um_clear     : BOOLEAN  -- clear user menu on start
		r_curr_pt    : INTEGER  -- r curr pt of mvm
		do_nr_lstba  : INTEGER  -- digital output is_last_batch
		do_nr_iswrt  : INTEGER  -- digital output is_write_allowed
		is_debug     : BOOLEAN  -- bool determining whether to log to tp
		min_stat_t   : INTEGER  -- state update delay when not processing traj
		max_stat_t   : INTEGER  -- state update delay when processing traj
	ENDSTRUCTURE



CONST
	LOG_PFIX     = 'RTRJ '
	COND_AH      =  736  -- ABORT handler id (randomly chosen, but less
	                     -- likely to clash than simply '1')
	COND_ES      =  737  -- E-stop handler id
	CFG_OK       =    0  -- config ok
	CFG_NOTDONE  =   -1  -- configuration not checked: user action required
	EWOULDBLOCK  =   282 -- shadow of EAGAIN
	FILE_ILL_PRM =  2032 -- FILE-032 Illegal parameter
	HOST_CTAG_ER = 67144 -- HOST-144 Comm Tag error
	SEV_ABORT    =    2  -- ABORT severity
	MTION_GRP    =    1  -- motion group we target
	                     -- TODO: add support for multi-group (GH #9)



--------------------------------------------------------------------------------
--
-- local variables
--
--------------------------------------------------------------------------------
VAR
	cfg_         IN SHADOW : cfg_t          -- configuration
	stat_                  : INTEGER
	sleep_time_            : INTEGER
	t_dly_stat  FROM ros_state : INTEGER
	t_intr_wait FROM ros_state : INTEGER
	shutdwn_req_           : BOOLEAN        -- program abort requested status
	sock_                  : ssock_t        -- server socket instance
	sock_fd_               : FILE           -- file descriptor has to be declared here
	grp_nfo_               : grp_info_t     -- motion group info cache
	msgFDF2_               : smFDF2_t
	conn_info              : smFDF0_t       -- connection info message
	smFDF2_lst_            : smFDF2_lst_t   -- list of DYN_JOINTS_TRAJ_PT msgs
	outs_msgs_             : INTEGER        -- number of messages received and to ACK
	pts_to_drv			   : INTEGER
	i					   : INTEGER
	i_adj				   : INTEGER
	i_pr				   : INTEGER
	pos_start			   : JOINTPOS
	num_points			   : INTEGER
	t_recv_traj            : INTEGER
	t_wrt_traj             : INTEGER
	t_des                  : INTEGER
	is_conn_info           : BOOLEAN
	cninf_len__            : INTEGER
	strt_msgs              : INTEGER
	pts_read               : ARRAY[16] OF smFDF2_t



--------------------------------------------------------------------------------
--
-- remote routine prototypes
--
--------------------------------------------------------------------------------
%INCLUDE rosfanuc\rosfanuc.klh
%INCLUDE mikmsgs\smFDF0.klh
%INCLUDE mikmsgs\smFDF2.klh
%INCLUDE simplemsg\sm_hdr.klh
%INCLUDE indlog\indlog.klh
%INCLUDE libssock.klh
%INCLUDE klrdutil.kl



--------------------------------------------------------------------------------
--
-- local routine prototypes
--
--------------------------------------------------------------------------------
ROUTINE hndl_client_(fd : FILE; cfg : cfg_t; grp_nfo : grp_info_t) : INTEGER FROM ros_traj
ROUTINE has_msgs_(len : INTEGER; fd : FILE) : INTEGER FROM ros_traj
ROUTINE read_smFDF2_(fd : FILE; msg : smFDF2_t) : INTEGER FROM ros_traj
ROUTINE ack_svcreq_(msg_type : INTEGER; seq : INTEGER; fd : FILE) : INTEGER FROM ros_traj
ROUTINE nack_svcreq_(msg_type : INTEGER; seq : INTEGER; fd : FILE) : INTEGER FROM ros_traj
ROUTINE check_cfg_(cfg : cfg_t) : INTEGER FROM ros_traj
ROUTINE install_ah_ FROM ros_traj
ROUTINE remove_ah_ FROM ros_traj
ROUTINE install_es_ FROM ros_traj
ROUTINE remove_es_ FROM ros_traj
ROUTINE push_traj(traj : smFDF2_lst_t; nr_points : INTEGER) : INTEGER FROM ros_traj
ROUTINE push_pt_(msg : smFDF2_t; no_block : BOOLEAN; cfg : cfg_t; grp_nfo : grp_info_t; pt_counter : INTEGER) : INTEGER FROM ros_traj
ROUTINE cancl_mtion_(cfg : cfg_t) FROM ros_traj
ROUTINE rst_cnclmtn_(cfg : cfg_t) FROM ros_traj
ROUTINE dlog_error_a(msg : STRING; nr : INTEGER) FROM ros_traj
ROUTINE dlog_info_a(msg : STRING; nr : INTEGER) FROM ros_traj
ROUTINE dlog_error(msg : STRING) FROM ros_traj
ROUTINE dlog_info(msg : STRING) FROM ros_traj



--------------------------------------------------------------------------------
--
-- Main program
--
--------------------------------------------------------------------------------
BEGIN
	lbl_start::
		-- dummy label used after unexpected disconnect
	stat_        = 0
	shutdwn_req_ = FALSE
	strt_msgs    = 0
	is_conn_info = FALSE
	cninf_len__  = 0
	pts_to_drv = 0
	t_recv_traj = 0
	t_wrt_traj = 0
	t_des = 0
	strt_msgs = 0

	CLOSE FILE sock_fd_
	IF(UNINIT(cfg_.is_debug)) THEN
		cfg_.is_debug = TRUE
	ENDIF
	IF(UNINIT(cfg_.min_stat_t)) THEN
		cfg_.min_stat_t = 8
	ENDIF
	IF(UNINIT(cfg_.max_stat_t)) THEN
		cfg_.max_stat_t = 700
	ENDIF


	-- check config
	stat_ = check_cfg_(cfg_)
	IF (stat_ <> CFG_OK) THEN
		log_error_a(LOG_PFIX + 'cfg err:', stat_)
		log_error(LOG_PFIX + 'check cfg')
		-- errors with config always force user to log window
		log_force
		POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT)
		RETURN
	ENDIF

	-- reset skip sig
	SET_INT_REG(cfg_.r_skip_sig, 0, stat_)
	IF (stat_ <> 0) THEN
		log_error(LOG_PFIX + 'could not reset skip signal')
		POST_ERR(stat_, '', 0, SEV_ABORT)
	ENDIF

	SET_INT_REG(cfg_.r_pts_to_drv, pts_to_drv, stat_)
	IF (stat_ <> 0) THEN
		log_error(LOG_PFIX + 'could not reset pts to drive')
		POST_ERR(stat_, '', 0, SEV_ABORT)
	ENDIF

	SET_INT_REG(cfg_.r_first_pr, cfg_.first_pr, stat_)
	IF (stat_ <> 0) THEN
		log_error(LOG_PFIX + 'could not set first PR')
		POST_ERR(stat_, '', 0, SEV_ABORT)
	ENDIF

	SET_INT_REG(cfg_.r_buff_size, cfg_.pt_buff_size, stat_)
	IF (stat_ <> 0) THEN
		log_error(LOG_PFIX + 'could not set buff size')
		POST_ERR(stat_, '', 0, SEV_ABORT)
	ENDIF

	pos_start = CURPOS(0,0)
	i_adj = cfg_.pt_buff_size - 1
	FOR i=0 TO i_adj DO
		i_pr = i + cfg_.first_pr
		SET_JPOS_REG(i_pr, pos_start, stat_)
		IF (stat_ <> 0) THEN
			log_error(LOG_PFIX + 'could not set reset PRs')
			POST_ERR(stat_, '', 0, SEV_ABORT)
		ENDIF
	ENDFOR

	-- enable log output
	IF (cfg_.um_clear) THEN log_clear; ENDIF

	-- rest of config
	sleep_time_ = ROUND(1000.0 / cfg_.loop_hz)
	t_intr_wait = ROUND(1000.0 / cfg_.loop_hz)

	-- cache axis info
	-- TODO: add multi-group support
	stat_ = rf_ld_grpnfo(MTION_GRP, grp_nfo_)
	IF (stat_ <> 0) THEN
		log_error_a(LOG_PFIX + 'err axis info:', stat_)
		-- nothing we can do
		POST_ERR(stat_, '', 0, SEV_ABORT)
	ENDIF
	dlog_info_a(LOG_PFIX + 'loaded grp:', MTION_GRP)


	-- initialise ABORT handler
	install_ah_

	-- initialize ESTOP handler
	install_es_

	-- init server socket
	stat_ = ssock_ctor(sock_, cfg_.s_tcp_nr , cfg_.s_tag_nr)
	IF (stat_ <> 0) THEN
		IF (stat_ = TAG_CONF_ERR) THEN
			dlog_error_a(LOG_PFIX + 'cfg err, TAG idx:', cfg_.s_tag_nr)
		ELSE
			dlog_error_a(LOG_PFIX + 'ssock_ctor err:', stat_)
		ENDIF
		-- nothing we can do, abort
		POST_ERR(HOST_CTAG_ER, '', 0, SEV_ABORT)
	ENDIF

	-- make sure socket is closed (don't care about result)
	stat_ = ssock_dconnf(sock_)

	WHILE (NOT shutdwn_req_) DO

		-- inform user
		dlog_info(LOG_PFIX + 'wait client')

		-- we need binary mode (UnFormatted)
		-- KAREL Reference Manual, MARRC75KR07091E Rev C, sec 7.3.1
		SET_FILE_ATR(sock_fd_, ATR_UF)

		-- wait for connection
		stat_ = ssock_accpt2(sock_, sock_fd_)
		IF (stat_ <> 0) THEN
			dlog_error_a(LOG_PFIX + 'sock_accept err:', stat_)
			-- can't continue
			shutdwn_req_ = TRUE
			GOTO lbl_break0
		ENDIF

		-- inform user
		dlog_info(LOG_PFIX + 'connected')

		-- init mconn info msg
		smFDF0_ctor(conn_info)

		-- wait for connection info
		cninf_len__ = 4 + sm_hdr_len(conn_info.hdr) + smFDF0_len(conn_info)

		dlog_info(LOG_PFIX + 'waiting for conn_info')
		while(is_conn_info = FALSE) DO
			-- check for new msgs
			strt_msgs = has_msgs_(cninf_len__, sock_fd_)
			IF(strt_msgs > 0) THEN
				READ sock_fd_(stat_)
				stat_ = sm_hdr_read(conn_info.hdr, sock_fd_)
				IF (stat_ <> 0) THEN
					GOTO lbl_break0
				ENDIF
				stat_ = smFDF0_read(conn_info, sock_fd_)
				IF(stat_ <> 0) THEN
					GOTO lbl_break0
				ENDIF
				is_conn_info = TRUE
			ELSE
				dlog_info(LOG_PFIX + 'no conn_info yet')
				DELAY(1000)
			ENDIF
		ENDWHILE

		dlog_info(LOG_PFIX + 'rcvd conn info')


		-- client connected, 'spin-off' connection handler
		stat_ = hndl_client_(sock_fd_, cfg_, grp_nfo_)

		-- if there was no error and we were also not requested to shutdown,
		-- continue listening for clients
		IF ((stat_ = 0) AND (NOT shutdwn_req_)) THEN GOTO lbl_cont0; ENDIF

		-- in other cases, exit with forced disconnect
	lbl_break0::
		stat_ = ssock_dconn2(sock_, sock_fd_)
		stat_ = ssock_dconnf(sock_)
		-- disable the ABORT handler
		remove_ah_
		-- disable the ESTOP handler
		remove_es_
		GOTO lbl_start

	lbl_cont0::
		-- wait for new client
		dlog_info(LOG_PFIX + 'disconnected')
		SET_INT_REG(cfg_.r_pts_to_drv, 0, stat_)
		IF (stat_ <> 0) THEN
			dlog_error(LOG_PFIX + 'could not reset pts to drive')
			POST_ERR(stat_, '', 0, SEV_ABORT)
		ENDIF
		pos_start = CURPOS(0,0)
		i_adj = cfg_.pt_buff_size - 1
		FOR i=0 TO i_adj DO
			i_pr = i + cfg_.first_pr
			SET_JPOS_REG(i_pr, pos_start, stat_)
			IF (stat_ <> 0) THEN
				dlog_error(LOG_PFIX + 'could not reset PRs')
				POST_ERR(stat_, '', 0, SEV_ABORT)
			ENDIF
		ENDFOR

		-- always delay returning to accept() a bit, to make sure user can
		-- escape runaway loops
		DELAY (cfg_.s_accpt_dlay)

	-- /WHILE (NOT shutdwn_req_)
	ENDWHILE


	-- make sure socket is closed (don t care about result)
	stat_ = ssock_dconnf(sock_)

	-- disable the ABORT handler
	remove_ah_
	-- disable the ESTOP handler
	remove_es_

	-- done
	dlog_info(LOG_PFIX + 'exit')
END ros_traj



--------------------------------------------------------------------------------
--
-- Main client loop
--
--------------------------------------------------------------------------------
ROUTINE hndl_client_
CONST
	HEAD_OF_LIST = 1
	NO_BLOCK     = TRUE
VAR
	stat__       : INTEGER
	req_len__    : INTEGER
	start_pos    : JOINTPOS
	iVal         : INTEGER
	flag_ptv	 : INTEGER
	flag_cp      : INTEGER
	num_pts_read : INTEGER
	p            : INTEGER

BEGIN
	-- init 'thread' local
	stat__       = 0
	num_points = 0
	outs_msgs_   = 0
	t_des = 0

	-- init msg instance and msg list
	smFDF2_ctor(msgFDF2_)
	stat__ = smFDF2l_ctor(smFDF2_lst_)

	FOR p = 1 TO 16 DO
		pts_read[p] = msgFDF2_
	ENDFOR

	start_pos = CURPOS(0,0)
	SET_JPOS_REG(cfg_.first_pr, start_pos, stat__)

	IF (stat__ <> 0) THEN
		dlog_error(LOG_PFIX + 'could not intialize first PR')
		POST_ERR(stat__, '', 0, SEV_ABORT)
	ENDIF

	-- calc nr of bytes we need for single msg
	req_len__ = 4 + sm_hdr_len(msgFDF2_.hdr) + smFDF2_len(msgFDF2_, conn_info)

	-- service connected client
	WHILE (NOT shutdwn_req_) DO

		-- check for new msgs
		outs_msgs_ = has_msgs_(req_len__, fd)

		-- exit on error
		IF (outs_msgs_ < 0) THEN
			dlog_error_a(LOG_PFIX + 'has msg err:', outs_msgs_)
			GOTO lbl_break1
		ENDIF

		-- if we haven't received anything, don't deserialise
		IF (outs_msgs_ = 0) THEN
			GOTO lbl_cont1
		ENDIF
		CONNECT TIMER TO t_des
		-- deserialise
		stat__ = read_smFDF2_(fd, msgFDF2_)
		IF (stat__ <= 0) THEN
			dlog_error_a(LOG_PFIX + 'B read err:', stat__)
			GOTO lbl_break1
		ENDIF
		DISCONNECT TIMER t_des
		num_pts_read = stat__
		-- TODO: ADD PROCESSING IN BATCHES HERE
		FOR p = 1 TO num_pts_read DO
			msgFDF2_ = pts_read[p]

			-- crude check
			IF (msgFDF2_.hdr.msg_type <> SMFDF2_ID) THEN
				log_error_a(LOG_PFIX + 'unkn msg:', msgFDF2_.hdr.msg_type)
				GOTO lbl_break1
			ENDIF


			-- check special sequence nrs: if TRAJ STOP, clear list and abort current motion
			IF (msgFDF2_.sequence < 0) THEN
				-- we only support the following special seq nrs
				SELECT (msgFDF2_.sequence) OF
					CASE (SM_SEQ_STRJD):
						t_dly_stat =  cfg.max_stat_t  -- increase state update delay
						t_intr_wait = 4 * t_intr_wait
						t_recv_traj = 0
						t_des = 0
						CONNECT TIMER TO t_recv_traj
						dlog_info(LOG_PFIX + 'traj start received')
						-- start requested: clear list
						smFDF2l_cler(smFDF2_lst_)
						smFDF2l_apnd(smFDF2_lst_, msgFDF2_)
						num_points = 1
					CASE (SM_SEQ_ETRAJ):
						dlog_info(LOG_PFIX + 'traj end received')
						smFDF2l_apnd(smFDF2_lst_, msgFDF2_)
						num_points = num_points + 1
						-- push points and start execution
						DISCONNECT TIMER t_recv_traj
						dlog_info_a('DES MS: ', t_recv_traj)
						dlog_info_a('RECV MS: ', t_recv_traj)
						dlog_info_a('RECV PPT MS: ', t_recv_traj DIV num_points)
						t_wrt_traj = 0
						CONNECT TIMER TO t_wrt_traj
						t_dly_stat = cfg.min_stat_t
						t_intr_wait = 8
						stat__ = push_traj(smFDF2_lst_, num_points)
						dlog_info_a('Push traj res: ', stat__)
						DISCONNECT TIMER t_wrt_traj
					CASE (SM_SEQ_STPRJ):
						dlog_info(LOG_PFIX + 'traj STOP')
						-- stop requested: clear list, request cancel TP motion
						smFDF2l_cler(smFDF2_lst_)
						num_points = 0
						outs_msgs_ = 0
						cancl_mtion_(cfg)
						t_intr_wait = 8
						t_dly_stat = cfg.min_stat_t
					ELSE:
						log_warn_a(LOG_PFIX + 'unsupp seq:', msgFDF2_.sequence)
						log_warn(LOG_PFIX + 'please report')
						t_dly_stat = cfg.min_stat_t
						GOTO lbl_break1
				ENDSELECT
				-- failure to send reply is failure of everything, so exit client
				-- hndlr 'thread'
				IF (stat__ < 0) THEN
					GOTO lbl_break1
				ENDIF
			ELSE
				smFDF2l_apnd(smFDF2_lst_, msgFDF2_)
				num_points = num_points + 1
			ENDIF

			-- reply if service request
			IF (msgFDF2_.hdr.comm_type = SM_CT_SVCREQ) THEN
				dlog_info_a(LOG_PFIX + 'ack msg: ', msgFDF2_.hdr.msg_type)
				-- ack recieved point
				stat__ = ack_svcreq_(SMFDF2_ID, msgFDF2_.sequence, fd)
				-- failure to send reply is failure of everything, so exit client
				IF (stat__ <> 0) THEN
					GOTO lbl_break1
				ENDIF
			ENDIF
		ENDFOR

		-- handled msgs
		GOTO lbl_cont_ns

	lbl_cont1::
		DELAY (sleep_time_)

	lbl_cont_ns::
		-- continue without delay

	ENDWHILE

lbl_break1::
	dlog_info(LOG_PFIX + 'hndl_client exit')

	RETURN (-ABS(stat__))
END hndl_client_



--------------------------------------------------------------------------------
--
-- Check if messages are present in buffer
--
--------------------------------------------------------------------------------
ROUTINE has_msgs_
VAR
	stat__       : INTEGER
	b_avail__    : INTEGER
BEGIN
	stat__       = 0
	b_avail__    = 0

	CLR_IO_STAT(fd)
	BYTES_AHEAD(fd, b_avail__, stat__)
	IF (stat__ <> 0) THEN RETURN (-ABS(stat__)); ENDIF
	-- return nr of complete msgs in socket fd buf
	RETURN (b_avail__ DIV len)
END has_msgs_



--------------------------------------------------------------------------------
--
-- Read up to 16 dynamic traj pt msg(s) and store them in pts_read array
--
--------------------------------------------------------------------------------
ROUTINE read_smFDF2_
VAR
	stat__       : INTEGER
	len__        : INTEGER
	i__          : INTEGER
	pts_to_read  : INTEGER
BEGIN
	stat__ = 0
	len__  = 0
	pts_to_read = 16
	IF(outs_msgs_ < 16) THEN
		pts_to_read = outs_msgs_
	ENDIF

	-- unfortunately there seems to be no way to read a whole array from a File which severly impacts performance
	FOR i__ = 1 TO pts_to_read DO
		READ fd(len__, msg.hdr.msg_type, msg.hdr.comm_type, msg.hdr.reply_type)
		stat__ = smFDF2_read(msg, fd, conn_info)
		IF (stat__ <> 0) THEN GOTO lbl_exitF1; ENDIF
		pts_read[i__] = msg
	ENDFOR

	RETURN (pts_to_read)

lbl_exitF1::
	RETURN (-1)
END read_smFDF2_



--------------------------------------------------------------------------------
--
-- Hard-coded minimal service reply.
--
--------------------------------------------------------------------------------
ROUTINE send_reply_(msg_type : INTEGER; seq : INTEGER; res : INTEGER; fd : FILE) : INTEGER
VAR
	stat__       : INTEGER
	len          : INTEGER
CONST
	COMM_TYPE    = SM_CT_SVCRPL
BEGIN
	len = 12
	WRITE fd(len, msg_type, COMM_TYPE, res, CR)
	stat__ = IO_STATUS(fd)
	RETURN (-ABS(stat__))
END send_reply_



--------------------------------------------------------------------------------
--
-- ACK msg.
--
---[in    ]  msg_type: msg_type number of svc request
-- [in    ]  seq     : sequence number of the msg to ACK
-- [in    ]  fd      : file descriptor to serialise ACK to
-- [out   ]          : 0 IFF no error
--
--------------------------------------------------------------------------------
ROUTINE ack_svcreq_
BEGIN
	RETURN (send_reply_(msg_type, seq, SM_RT_SUCC, fd))
END ack_svcreq_



--------------------------------------------------------------------------------
--
-- NACK msg. Something erred.
--
---[in    ]  msg_type: msg_type number of svc request
-- [in    ]  seq     : sequence number of the msg to NACK
-- [in    ]  fd      : file descriptor to serialise NACK to
-- [out   ]          : 0 IFF no error
--
--------------------------------------------------------------------------------
ROUTINE nack_svcreq_
BEGIN
	RETURN (send_reply_(msg_type, seq, SM_RT_FAIL, fd))
END nack_svcreq_



--------------------------------------------------------------------------------
--
-- Check cfg
--
--------------------------------------------------------------------------------
ROUTINE check_cfg_
VAR
	diff : INTEGER
BEGIN
	-- make sure config has been setup

	IF (UNINIT(cfg.pt_buff_size)) THEN RETURN ( -1); ENDIF
	IF (UNINIT(cfg.first_pr    )) THEN RETURN ( -2); ENDIF
	IF (UNINIT(cfg.r_buff_size )) THEN RETURN ( -3); ENDIF
	IF (UNINIT(cfg.r_first_pr  )) THEN RETURN ( -4); ENDIF
	IF (UNINIT(cfg.r_pts_to_drv)) THEN RETURN ( -5); ENDIF
	IF (UNINIT(cfg.loop_hz     )) THEN RETURN (-10); ENDIF
	IF (UNINIT(cfg.r_skip_sig  )) THEN RETURN (-11); ENDIF
	IF (UNINIT(cfg.s_accpt_dlay)) THEN RETURN (-12); ENDIF
	IF (UNINIT(cfg.s_tag_nr    )) THEN RETURN (-13); ENDIF
	IF (UNINIT(cfg.s_tcp_nr    )) THEN RETURN (-14); ENDIF
	IF (UNINIT(cfg.tp_val_trstp)) THEN RETURN (-15); ENDIF
	IF (UNINIT(cfg.um_clear    )) THEN RETURN (-16); ENDIF
	IF (UNINIT(cfg.r_curr_pt   )) THEN RETURN (-17); ENDIF
	IF (UNINIT(cfg.do_nr_lstba )) THEN RETURN (-18); ENDIF
	IF (UNINIT(cfg.do_nr_iswrt )) THEN RETURN (-19); ENDIF
	IF (UNINIT(cfg.is_debug    )) THEN RETURN (-20); ENDIF
	IF (UNINIT(cfg.min_stat_t  )) THEN RETURN (-21); ENDIF
	IF (UNINIT(cfg.max_stat_t  )) THEN RETURN (-22); ENDIF

	-- all ok
	RETURN (CFG_OK)
END check_cfg_



--------------------------------------------------------------------------------
--
-- Application handler for ABORT signals.
--
--------------------------------------------------------------------------------
ROUTINE ab_hndlr_
VAR
	status : INTEGER 
BEGIN
	shutdwn_req_ = TRUE
	CANCEL FILE sock_fd_
	SELECT_TPE('MIKADO', status)
	ABORT
END ab_hndlr_



--------------------------------------------------------------------------------
--
-- Installs a condition handler that catches ABORT signals to allow the
-- application to 'gracefully' exit.
--
--------------------------------------------------------------------------------
ROUTINE install_ah_
BEGIN
	CONDITION[COND_AH]: WITH $SCAN_TIME = 256
		WHEN ABORT DO
			NOABORT
			ab_hndlr_
	ENDCONDITION
	ENABLE CONDITION[COND_AH]
END install_ah_



--------------------------------------------------------------------------------
--
-- Deregisters the ABORT condition handler.
--
--------------------------------------------------------------------------------
ROUTINE remove_ah_
BEGIN
	PURGE CONDITION[COND_AH]
END remove_ah_



--------------------------------------------------------------------------------
--
-- Handler for E-stop.
--
--------------------------------------------------------------------------------
ROUTINE estop_hndlr_
VAR
	status: INTEGER
BEGIN
	-- E-stop pressed, so clear list, request cancel TP motion
	smFDF2l_cler(smFDF2_lst_)
	outs_msgs_ = 0
	cancl_mtion_(cfg_)
END estop_hndlr_



--------------------------------------------------------------------------------
--
-- Installs a condition handler that catches E-stop signals so restarting
-- does not make it continue previous motion.
--
--------------------------------------------------------------------------------
ROUTINE install_es_
CONST
	ERR_PAN_ESTP = 11001
	ERR_TP_ESTOP = 11002
	ERR_EXT_ESTP = 11007
BEGIN
	CONDITION[COND_ES]: WITH $SCAN_TIME = 256
		WHEN ERROR[ERR_PAN_ESTP] OR ERROR[ERR_TP_ESTOP] OR ERROR[ERR_EXT_ESTP] DO
			UNPAUSE
			ENABLE CONDITION[COND_ES]
			estop_hndlr_
	ENDCONDITION
	ENABLE CONDITION[COND_ES]
END install_es_



--------------------------------------------------------------------------------
--
-- Deregisters the e-stop condition handler.
--
--------------------------------------------------------------------------------
ROUTINE remove_es_
BEGIN
	PURGE CONDITION[COND_ES]
END remove_es_



--------------------------------------------------------------------------------
--
-- This routine pushes a new trajectory to ROS_MOVESM. If number_pts > buffer pt_buff_size
-- the trajectory is pushed in batches of size pt_buff_size
--
--
-- [in    ]  traj   : list of msgs containing the traj pts
-- [in    ]  num_points : number of points inside the trajectory
-- [return]        :    0 IFF no error
--                     -1 IFF new position not reachable
--                   < -1 on any other error
--
--------------------------------------------------------------------------------
ROUTINE push_traj
VAR
	stat__       : INTEGER
	jpos__       : JOINTPOS
	rem_pts      : INTEGER
	pt_msg       : smFDF2_t
	curr_pt      : INTEGER
	cp_arr 		 : ARRAY[6] OF REAL
	pos_diff     : REAL
BEGIN
	IF (nr_points <= 0) THEN
		dlog_info(LOG_PFIX + 'Pushing trajectory of 0 pts')
		RETURN(-1)
	ENDIF
	dlog_info_a(LOG_PFIX + 'Pushing pts:', nr_points)
	IF(nr_points>cfg_.pt_buff_size) THEN
		dlog_info(LOG_PFIX + 'Executing in batches')
	ENDIF
	rem_pts = nr_points
	IF(rem_pts > 0) THEN
		-- check if first points = current position
		WAIT FOR DOUT[cfg_.do_nr_iswrt]
		pt_msg = traj[1]
		jpos__ = CURJPOS(0,0)
		CNV_JPOS_REL(jpos__, cp_arr, stat__)
		IF(ABS(cp_arr[1]-pt_msg.joint_data[1]) > 0.1) THEN
			log_error(LOG_PFIX + 'j1 differs from curr pt')
			GOTO lbl_fp_ne
		ENDIF
		IF(ABS(cp_arr[2]-pt_msg.joint_data[2]) > 0.1) THEN
			log_error(LOG_PFIX + 'j2 differs from curr pt')
			GOTO lbl_fp_ne
		ENDIF
		IF(ABS(cp_arr[3]-pt_msg.joint_data[3]) > 0.1) THEN
			log_error(LOG_PFIX + 'j3 differs from curr pt')
			GOTO lbl_fp_ne
		ENDIF
		IF(ABS(cp_arr[4]-pt_msg.joint_data[4]) > 0.1) THEN
			log_error(LOG_PFIX + 'j4 differs from curr pt')
			GOTO lbl_fp_ne
		ENDIF
		IF(ABS(cp_arr[5]-pt_msg.joint_data[5]) > 0.1) THEN
			log_error(LOG_PFIX + 'j5 differs from curr pt')
			GOTO lbl_fp_ne
		ENDIF
		IF(ABS(cp_arr[6]-pt_msg.joint_data[6]) > 0.1) THEN
			log_error(LOG_PFIX + 'j6 differs from curr pt')
			GOTO lbl_fp_ne
		ENDIF
	ENDIF
	WHILE(rem_pts > 0) DO
		-- get write access wait for write allowed -> movesm is not driving
		WAIT FOR DOUT[cfg_.do_nr_iswrt]
		-- set curr mv pt to 0
		SET_INT_REG(cfg_.r_curr_pt, 0, stat__)
		DOUT[cfg_.do_nr_lstba] = OFF
		FOR curr_pt = 1 TO cfg_.pt_buff_size DO
			pt_msg = traj[nr_points - rem_pts + 1]
			-- convert pt
			stat__ = jdta_to_jpos(pt_msg.joint_data, grp_nfo_, jpos__, conn_info)
			-- if velocity should be used be could reserve
			-- the same Registers as PRs and write pt_msg.velocity into
			-- the corresponding Register. This only works if velocity is actually sent.
			-- write pt
			SET_JPOS_REG(cfg_.first_pr + curr_pt - 1, jpos__, stat__)
			IF (stat__ <> 0) THEN
				dlog_error_a(LOG_PFIX + 'could not write pt', curr_pt)
				RETURN(-1)
			ENDIF
			rem_pts = rem_pts - 1
			IF (rem_pts <= 0) THEN
				-- is last batch
				GOTO lbl_lst_ba
			ENDIF
		ENDFOR
		-- check if abort requested (read msgs?)
		-- set number of pts to drive to buffer size
		SET_INT_REG(cfg_.r_pts_to_drv, cfg_.pt_buff_size, stat__)
		-- release write access
		IF(nr_points = cfg_.pt_buff_size) THEN
			DOUT[cfg_.do_nr_lstba] = ON
		ENDIF
		DOUT[cfg_.do_nr_iswrt] = OFF
	ENDWHILE

	RETURN (0)

	lbl_lst_ba::
		-- set number of pts to drive
		IF (nr_points MOD cfg_.pt_buff_size <> 0) THEN
			SET_INT_REG(cfg_.r_pts_to_drv, nr_points MOD cfg_.pt_buff_size, stat__)
		ELSE
			SET_INT_REG(cfg_.r_pts_to_drv, cfg_.pt_buff_size, stat__)
		ENDIF
		DOUT[cfg_.do_nr_lstba] = ON
		DOUT[cfg_.do_nr_iswrt] = OFF
		RETURN (0)

	lbl_fp_ne::
		-- first point not equal to current pose
		SET_INT_REG(cfg_.r_pts_to_drv, 0, stat__)
		DOUT[cfg_.do_nr_iswrt] = OFF
		RETURN(-1)
END push_traj



--------------------------------------------------------------------------------
--
-- LOGGING METHODS
--
--------------------------------------------------------------------------------
ROUTINE dlog_error_a
BEGIN
  IF (cfg_.is_debug) THEN
  	log_error_a(msg, nr)
  ENDIF
END dlog_error_a


ROUTINE dlog_error
BEGIN
  IF (cfg_.is_debug) THEN
  	log_error(msg)
  ENDIF
END dlog_error


ROUTINE dlog_info_a
BEGIN
  IF (cfg_.is_debug) THEN
  	log_info_a(msg, nr)
  ENDIF
END dlog_info_a


ROUTINE dlog_info
BEGIN
  IF (cfg_.is_debug) THEN
  	log_info(msg)
  ENDIF
END dlog_info



--------------------------------------------------------------------------------
--
-- Cncl motion
--
--------------------------------------------------------------------------------
ROUTINE cancl_mtion_
BEGIN
	log_info(LOG_PFIX + 'signal traj SKIP')
	SET_INT_REG(cfg.r_skip_sig, cfg.tp_val_trstp, 0)
END cancl_mtion_


ROUTINE rst_cnclmtn_
BEGIN
	SET_INT_REG(cfg.r_skip_sig, 0, 0)
END rst_cnclmtn_
