PROGRAM rtraj_cfg
--------------------------------------------------------------------------------
--
-- ROS-Industrial configuration setup program - ROS_TRAJ.
--
-- NOTE: this program will configure ROS_TRAJ with its DEFAULT SETTINGS.
--
--
-- author: G.A. vd. Hoorn (TU Delft Robotics Institute)
--
--------------------------------------------------------------------------------
%ALPHABETIZE
%COMMENT = 'ROS//r3b'
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR




--------------------------------------------------------------------------------
--
-- remote types & constants
--
--------------------------------------------------------------------------------
%INCLUDE simplemsg\simplemsg.klt




--------------------------------------------------------------------------------
--
-- local types & constants
--
--------------------------------------------------------------------------------
CONST
	PROG_NAME    = 'ROS_TRAJ'

	FILE_ILL_PRM =  2032 -- FILE-032 Illegal parameter
	SEV_ABORT    =    2  -- ABORT severity

	-- config defaults
	RACCEPT_DLAY = 1000  -- default 'return to sock_accept' delay

	TAG_NR       =    4  -- Server tag
	TCP_PORT     = SM_SP_MOTION

	LOOP_HZ      =  125  -- Main loop freq (Hz).On 12ms ITP controllers
	                     -- ROS_TRAJ will run at 83 Hz (GH #203).

	MOT_SKIP_SIG =    1  -- value to write to SKIP CONDITION register to signal
	                     -- motion abort to TP side

	pt_buff_size = 30  -- size of buffer
	r_buff_size  = 76  -- buff size
	first_pr     = 61  -- first pr of buffer
	r_first_pr   = 75  -- int reg to store first pr
	r_pts_to_drv = 73  -- r of nr of pts that still need to be driven
	r_skip_sig   = 74  -- int reg monitored by SKIP CONDITION in TP
	r_curr_pr    = 71  -- r of curr pr of mvm
	r_curr_pt    = 72  -- r curr pt of mvm
	do_nr_pts2b  = 145 -- do for pts2drv block
	do_nr_curpb  = 146 -- do for curr_pt block
	LOG_PFIX     = 'TCFG '




--------------------------------------------------------------------------------
--
-- local variables
--
--------------------------------------------------------------------------------
VAR
	stat_        : INTEGER
	s_tag_nr_str : STRING[10]
	s_s_str      : STRING[13]
	s_var_str    : STRING[26]
	i			 : INTEGER




--------------------------------------------------------------------------------
--
-- remote routine prototypes
--
--------------------------------------------------------------------------------




--------------------------------------------------------------------------------
--
-- local routine prototypes
--
--------------------------------------------------------------------------------




--------------------------------------------------------------------------------
--
-- Main program
--
--------------------------------------------------------------------------------
BEGIN
	stat_ = 0

	-- set all settings to their defaults
	SET_VAR(0, PROG_NAME, 'cfg_.loop_hz', LOOP_HZ, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.s_accpt_dlay', RACCEPT_DLAY, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.s_tag_nr', TAG_NR, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.s_tcp_nr', TCP_PORT, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.tp_val_trstp', MOT_SKIP_SIG, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.um_clear', TRUE, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	-- driver specific
	SET_VAR(0, PROG_NAME, 'cfg_.pt_buff_size', pt_buff_size, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.r_buff_size', r_buff_size, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.first_pr', first_pr, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.r_first_pr', r_first_pr, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.r_pts_to_drv', r_pts_to_drv, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.r_skip_sig', r_skip_sig, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.r_curr_pr', r_curr_pr , stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.r_curr_pt', r_curr_pt, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.do_nr_pts2b', do_nr_pts2b, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	SET_VAR(0, PROG_NAME, 'cfg_.do_nr_curpb', do_nr_curpb, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

	CNV_INT_STR(TAG_NR, 2, 0, s_tag_nr_str)
	
	s_s_str = '$HOSTS_CFG[' + SUB_STR(s_tag_nr_str, 2,1) + ']'

	s_var_str = s_s_str + '.$STATE'
	SET_VAR(i, '*SYSTEM*', s_var_str, 1, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF
	s_var_str = s_s_str + '.$PROTOCOL'
	SET_VAR(i, '*SYSTEM*', s_var_str, 'SM', stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF
	s_var_str = s_s_str + '.$STATE'
	SET_VAR(i, '*SYSTEM*', s_var_str, 2, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF
	SET_VAR(i, '*SYSTEM*', s_var_str, 3, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF
    s_var_str = s_s_str + '.$OPER'
	SET_VAR(i, '*SYSTEM*', s_var_str, 3, stat_)
	IF (stat_ <> 0) THEN POST_ERR(FILE_ILL_PRM, '', 0, SEV_ABORT); ENDIF

END rtraj_cfg
