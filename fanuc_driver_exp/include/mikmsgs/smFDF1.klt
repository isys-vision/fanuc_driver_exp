%IFNDEF SIMPLEMSG_MSGS_SMFDF1_KLT__
%DEFINE SIMPLEMSG_MSGS_SMFDF1_KLT__


--------------------------------------------------------------------------------
--
-- Simple Message Connection Info (libsmFDF1) shared type
-- and constant decls
--
--------------------------------------------------------------------------------


%INCLUDE simplemsg\simplemsg.klt
%INCLUDE simplemsg\sm_hdr.klt


TYPE
	smFDF1_t FROM libsmFDF1 = STRUCTURE
		hdr          : sm_hdr_t
		nr_axis      : INTEGER
		nr_exaxis    : INTEGER
		sequence     : INTEGER
		joint_data   : ARRAY[SM_MAX_JOINT] OF REAL
		is_moving    : BOOLEAN
	ENDSTRUCTURE


	-- convenience: 'List ITem type' and 'LiST type'
	smFDF1_lit_t FROM libsmFDF1 = smFDF1_t
	smFDF1_lst_t FROM libsmFDF1 = PATH NODEDATA = smFDF1_lit_t


CONST
	smFDF1_ID    = 65009
	smFDF1_NAME  = 'Dynamic Joints Position'


%ENDIF -- SIMPLEMSG_MSGS_SMFDF1_KLT__