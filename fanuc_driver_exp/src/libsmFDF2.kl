PROGRAM libsmFDF2
--------------------------------------------------------------------------------
--
-- Simple Message Dynamic Joints Trajectory Point (libsmFDF2)
-- implementation
--
--
--------------------------------------------------------------------------------
%ALPHABETIZE
%COMMENT = 'ROS//r0'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR




--------------------------------------------------------------------------------
--
-- remote types & constants
--
--------------------------------------------------------------------------------
%INCLUDE ktype_sz.klt
%INCLUDE simplemsg\simplemsg.klt




--------------------------------------------------------------------------------
--
-- local types & constants
--
--------------------------------------------------------------------------------
%INCLUDE mikmsgs\smFDF2.klt
%INCLUDE mikmsgs\smFDF0.klt




--------------------------------------------------------------------------------
--
-- local variables
--
--------------------------------------------------------------------------------
VAR
	msg_len_     : INTEGER




--------------------------------------------------------------------------------
--
-- remote routine prototypes
--
--------------------------------------------------------------------------------
%INCLUDE simplemsg\sm_hdr.klh




--------------------------------------------------------------------------------
--
-- local routine prototypes
--
--------------------------------------------------------------------------------
%INCLUDE mikmsgs\smFDF2.klh




--------------------------------------------------------------------------------
--
-- Empty body
--
--------------------------------------------------------------------------------
BEGIN
END libsmFDF2




ROUTINE smFDF2_len
BEGIN
	msg_len_ = ((1 * SZ_INT) + (conn_info.nr_ax_traj * SZ_REAL))
	IF(conn_info.is_traj_vel = TRUE) THEN
		msg_len_ = msg_len_ + SZ_REAL
	ENDIF
	IF(conn_info.is_traj_dur = TRUE) THEN
		msg_len_ = msg_len_ + SZ_REAL
	ENDIF
	msg_len_ = msg_len_ + 4

	RETURN (msg_len_)
END smFDF2_len




ROUTINE smFDF2_ctor
BEGIN
	smFDF2_rset(this)
END smFDF2_ctor




ROUTINE smFDF2_rset
VAR
	i__          : INTEGER
BEGIN
	sm_hdr_rset(this.hdr)
	this.hdr.msg_type   = SMFDF2_ID
	this.hdr.comm_type  = SM_CT_INVAL
	this.hdr.reply_type = SM_RT_INVAL

	this.sequence = 0
	FOR i__ = 1 TO SM_MAX_JOINT DO
		this.joint_data[i__] = 0.0
	ENDFOR
	this.velocity = 0.0
	this.duration = 0.0
END smFDF2_rset




ROUTINE smFDF2_read
VAR
	stat__       : INTEGER
	eom_bits     : INTEGER
BEGIN
	stat__ = 0

	-- NOTE: ONLY fields in msg body are deserialised by this routine,
	--       pkt_len & header are CALLERs reponsibility
	READ fd(this.sequence)
	stat__ = IO_STATUS(fd)
	IF (stat__ <> 0) THEN RETURN (-stat__); ENDIF

	IF(conn_info.is_traj_dur = TRUE) THEN
		READ fd(this.duration)
		stat__ = IO_STATUS(fd)
		IF (stat__ <> 0) THEN RETURN (-stat__); ENDIF
	ENDIF
	IF(conn_info.is_traj_vel = TRUE) THEN
		READ fd(this.velocity)
		stat__ = IO_STATUS(fd)
		IF (stat__ <> 0) THEN RETURN (-stat__); ENDIF
	ENDIF

	IF(conn_info.nr_ax_traj > 5) THEN
		READ fd(this.joint_data[1], this.joint_data[2], this.joint_data[3],
		this.joint_data[4], this.joint_data[5], this.joint_data[6])
	ELSE
		READ fd(this.joint_data[1], this.joint_data[2],
			this.joint_data[3],this.joint_data[4], this.joint_data[5])
	ENDIF
	stat__ = IO_STATUS(fd)
	IF (stat__ <> 0) THEN RETURN (-stat__); ENDIF
	IF (conn_info.nr_eax_traj > 0) THEN
		SELECT (conn_info.nr_eax_traj) OF
			CASE (1):
				READ fd(this.joint_data[7])
			CASE (2):
				READ fd(this.joint_data[7], this.joint_data[8])
			CASE (3):
				READ fd(this.joint_data[7], this.joint_data[8], this.joint_data[9])
			CASE (4):
				READ fd(this.joint_data[7], this.joint_data[8], this.joint_data[9], this.joint_data[10])
		ENDSELECT

		stat__ = IO_STATUS(fd)
		IF (stat__ <> 0) THEN RETURN (-stat__); ENDIF
	ENDIF

	READ fd(eom_bits)
	stat__ = IO_STATUS(fd)
	IF (stat__ <> 0) THEN RETURN (-stat__); ENDIF
	-- TODO: perhaps return nr of bytes consumed, so it can be checked
	--       against header.len by caller
	RETURN (-ABS(stat__))
END smFDF2_read




--- list routines --------------------------------------------------------------

ROUTINE smFDF2l_ctor
BEGIN
	smFDF2l_cler(this)
	RETURN (0)
END smFDF2l_ctor




ROUTINE smFDF2l_size
BEGIN
	RETURN (PATH_LEN(this))
END smFDF2l_size




ROUTINE smFDF2l_cler
VAR
	i__ : INTEGER
BEGIN
	i__ = smFDF2l_size(this)
	-- TODO: why not just use 'i__'?
	WHILE (smFDF2l_size(this) > 0) DO
		smFDF2l_rmov(this, i__)
		i__ = smFDF2l_size(this)
	ENDWHILE
END smFDF2l_cler




ROUTINE smFDF2l_add
VAR
	stat__ : INTEGER
	tmp__  : INTEGER
BEGIN
	APPEND_NODE(this, stat__)
	-- TODO: check status of operation
	tmp__ = smFDF2l_size(this)
	this[tmp__] = e
END smFDF2l_add




ROUTINE smFDF2l_apnd
BEGIN
	smFDF2l_add(this, e)
END smFDF2l_apnd




ROUTINE smFDF2l_set
VAR
	tmp__  : smFDF2_lit_t
	stat__ : INTEGER
BEGIN
	tmp__ = smFDF2l_get(this, idx)
	this[idx] = e
	RETURN (tmp__)
END smFDF2l_set




ROUTINE smFDF2l_get
BEGIN
	RETURN (this[idx])
END smFDF2l_get




ROUTINE smFDF2l_take
VAR
	tmp__  : smFDF2_lit_t
	stat__ : INTEGER
BEGIN
	tmp__ = smFDF2l_get(this, idx)
	DELETE_NODE(this, idx, stat__)
	-- TODO: check status of operation
	RETURN (tmp__)
END smFDF2l_take




ROUTINE smFDF2l_rmov
VAR
	stat__ : INTEGER
BEGIN
	DELETE_NODE(this, idx, stat__)
	-- TODO: check status of operation
END smFDF2l_rmov




ROUTINE smFDF2l_mpty
BEGIN
	RETURN (smFDF2l_size(this) = 0)
END smFDF2l_mpty




ROUTINE smFDF2l_ins
VAR
	stat__ : INTEGER
BEGIN
	INSERT_NODE(this, idx, stat__)
	-- TODO: check status of operation
	this[idx] = e
END smFDF2l_ins


--- /list routines -------------------------------------------------------------